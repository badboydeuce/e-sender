# Copy to .env and replace every value with a unique secret.
APP_ENV=development
DATABASE_URL=sqlite:///./esim_sender.db
ADMIN_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
DEVICE_ENROLLMENT_CODE=replace-with-a-separate-random-secret-at-least-32-characters
DEVICE_TOKEN_SECRET=replace-with-another-random-secret-at-least-32-characters
HEARTBEAT_TIMEOUT_SECONDS=180
