# Local development only. Use Railway Variables for production secrets.
DATABASE_URL=postgresql://user:password@localhost:5432/esender
DEVICE_ENROLLMENT_CODE=replace-with-a-random-secret-at-least-32-characters
DEVICE_TOKEN_SECRET=replace-with-another-random-secret-at-least-32-characters
ADMIN_API_TOKEN=replace-with-a-third-random-secret-at-least-32-characters
# Generate a separate random secret (at least 32 characters); required to encrypt APILayer keys.
API_KEY_ENCRYPTION_SECRET=replace-with-a-fourth-random-secret-at-least-32-characters
ESENDER_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
PORT=3000
